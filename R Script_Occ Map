# Встановлення пакетів
install.packages(c("sf", "ggplot2", "dplyr", "geodata"))

# Завантажуємо бібліотеки
library(sf)
library(ggplot2)
library(dplyr)
library(geodata)

# Завантажуємо межі України
ukraine_sf <- gadm(country = "UKR", level = 0, path = tempdir()) |> st_as_sf()

# Перетворюємо дані в просторовий об'єкт
que <- read.csv("quercus.csv")
species_sf <- st_as_sf(que, coords = c("decimalLongitude", "decimalLatitude"), crs = 4326)

# Створюємо карту
ggplot() +
  geom_sf(data = ukraine_sf, fill = "antiquewhite", color = "black", linewidth = 0.5) +
  geom_sf(data = species_sf, aes(color = species), size = 2) +
  coord_sf(xlim = c(22, 41), ylim = c(44, 53), expand = FALSE) +
  theme_minimal() +
  labs(title = "Розповсюдження Quercus rubra та Q.robur в Україні",
       x = "Довгота", y = "Широта") +
  theme(legend.position = "right")


